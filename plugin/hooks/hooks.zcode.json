{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/prompt-submit.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write|Edit|Grep|Glob",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/pre-tool-use.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-use.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-failure.mjs"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/stop.mjs"
            ]
          }
        ]
      }
    ]
  }
}
