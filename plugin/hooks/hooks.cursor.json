{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-session-start.mjs\""
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-prompt-submit.mjs\""
      }
    ],
    "preToolUse": [
      {
        "matcher": "Edit|Write|Read|Glob|Grep|Shell",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-pre-tool-use.mjs\""
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-post-tool-use.mjs\""
      }
    ],
    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-post-tool-failure.mjs\""
      }
    ],
    "preCompact": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-pre-compact.mjs\""
      }
    ],
    "subagentStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-subagent-start.mjs\""
      }
    ],
    "subagentStop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-subagent-stop.mjs\""
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-stop.mjs\""
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/cursor/agentmemory-session-end.mjs\""
      }
    ]
  }
}
