{
  "name": "agentmemory",
  "displayName": "agentmemory",
  "version": "0.9.30",
  "description": "Persistent memory for Devin CLI and Devin Desktop. Captures every session automatically, recalls with hybrid BM25 + vector + graph search, and exposes 54 memory tools over MCP. Keyless by default, runs on your machine. Not supported in cloud sessions.",
  "logo": "assets/icon.svg",
  "author": {
    "name": "Rohit Ghumare",
    "email": "ghumare64@gmail.com"
  },
  "homepage": "https://agent-memory.dev",
  "repository": "https://github.com/rohitg00/agentmemory",
  "license": "Apache-2.0",
  "keywords": [
    "memory",
    "mcp",
    "recall",
    "knowledge-graph",
    "agent-memory"
  ],
  "mcpServers": {
    "agentmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@agentmemory/mcp@0.9.30"
      ],
      "env": {
        "AGENTMEMORY_URL": "${AGENTMEMORY_URL:-http://localhost:3111}",
        "AGENTMEMORY_SECRET": "${AGENTMEMORY_SECRET:-}"
      }
    }
  }
}