# Normalize line endings on checkout/commit (see `git config core.autocrlf` on Windows).
* text=auto

# Application source and docs: LF in the repository
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.env.example text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows portable kit and batch launchers: CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Do not line-end normalize binaries
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.woff -text
*.woff2 -text
*.ttf -text
*.eot -text
*.zip -text
*.gz -text
*.wasm -text
*.db -text
*.sqlite -text
